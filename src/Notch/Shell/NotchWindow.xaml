<Window x:Class="Notch.Shell.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notch" Width="112" Height="28" Left="0" Top="0"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="{Binding IsTopmost}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
    </Window.InputBindings>
    <Border x:Name="Panel" Background="#080809" BorderBrush="#252527" BorderThickness="1" CornerRadius="17">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Поверх других окон" IsCheckable="True" IsChecked="{Binding IsTopmost}" />
                <MenuItem Header="Плавные анимации" IsCheckable="True" IsChecked="{Binding AnimationsEnabled}" />
                <MenuItem Header="История буфера обмена" IsCheckable="True" IsChecked="{Binding ClipboardEnabled}" />
                <MenuItem Header="{Binding StatusMessage}" IsEnabled="False" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolVisibility}}" />
                <Separator />
                <MenuItem Header="Выйти из Notch" Click="OnExitClick" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid ClipToBounds="True">
            <Button x:Name="ExpandButton" Style="{StaticResource NotchButton}" Command="{Binding ExpandCommand}"
                    Visibility="{Binding IsCollapsed, Converter={StaticResource BoolVisibility}}"
                    AutomationProperties.Name="Открыть Notch" ToolTip="Открыть Notch">
                <Border Width="24" Height="3" Background="#99999F" CornerRadius="2" />
            </Button>

            <Grid x:Name="ExpandedContent" Margin="12,9,12,10"
                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibility}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="notch" FontSize="12" FontWeight="Medium" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#C6C6CC" />
                    <TextBlock Text="!" FontSize="12" Foreground="#DEC494" HorizontalAlignment="Right" Margin="0,0,32,0"
                               VerticalAlignment="Center" ToolTip="{Binding StatusMessage}"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolVisibility}}" />
                    <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Content="&#xE70E;" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding CollapseCommand}" ToolTip="Свернуть · Esc" AutomationProperties.Name="Свернуть Notch" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,7,0,0">
                    <ItemsControl ItemsSource="{Binding Modules}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NotchButton}" Background="#151517" Margin="3,0" Padding="5,14"
                                        Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Foreground="{StaticResource Accent}" Margin="0,0,0,10" />
                                        <TextBlock Text="{Binding Title}" FontSize="10.5" TextAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="ModuleContent" Margin="12,9,12,12"
                  Visibility="{Binding IsModuleOpen, Converter={StaticResource BoolVisibility}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" HorizontalAlignment="Left"
                            Command="{Binding BackCommand}" ToolTip="Все модули · Esc" AutomationProperties.Name="Назад к модулям" />
                    <TextBlock Text="{Binding ActiveDescriptor.Title}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" HorizontalAlignment="Right"
                            Command="{Binding CollapseCommand}" ToolTip="Свернуть" AutomationProperties.Name="Свернуть Notch" />
                </Grid>
                <Border Grid.Row="1" Margin="0,9,0,0" ClipToBounds="True">
                    <ContentControl Content="{Binding ActiveContent}" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                </Border>
            </Grid>
            <Border VerticalAlignment="Bottom" Background="#33231C" CornerRadius="8" Margin="18,0,18,16" Padding="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#F2CAA8" FontSize="12" />
            </Border>
            <TextBlock Text="Открываем…" IsHitTestVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14"
                       Visibility="{Binding IsNavigating, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource TextSecondary}" FontSize="11" />
        </Grid>
    </Border>
</Window>
